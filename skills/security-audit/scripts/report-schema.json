{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "security-audit-findings",
  "title": "Security audit findings record",
  "description": "Contract for findings.json: one record per candidate, exactly one of three verdicts. Enforced by validate-findings.cjs.",
  "type": "array",
  "items": {
    "oneOf": [
      { "$ref": "#/$defs/confirmed" },
      { "$ref": "#/$defs/needs_validation" },
      { "$ref": "#/$defs/rejected" }
    ]
  },
  "$defs": {
    "verdict": {
      "type": "string",
      "enum": ["confirmed", "needs_validation", "rejected"]
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$",
      "description": "Stable source-derived identifier; identical for the same root cause in every state."
    },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "traceStep": {
      "type": "object",
      "required": ["kind", "file", "line", "scope", "description"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["entrypoint", "propagation", "sink"] },
        "file": { "$ref": "#/$defs/nonEmpty" },
        "line": { "type": "integer", "minimum": 1 },
        "scope": { "$ref": "#/$defs/nonEmpty" },
        "description": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "evidenceItem": {
      "type": "object",
      "required": ["file", "line", "description"],
      "additionalProperties": false,
      "properties": {
        "file": { "$ref": "#/$defs/nonEmpty" },
        "line": { "type": "integer", "minimum": 1 },
        "description": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "severityLevel": {
      "type": "string",
      "enum": ["informational", "low", "medium", "high", "critical"]
    },
    "score": {
      "type": "object",
      "required": ["score", "reason"],
      "additionalProperties": false,
      "properties": {
        "score": { "$ref": "#/$defs/severityLevel" },
        "reason": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "common": {
      "type": "object",
      "required": ["verdict", "fingerprint", "title", "description", "trace", "evidence"],
      "properties": {
        "verdict": { "$ref": "#/$defs/verdict" },
        "fingerprint": { "$ref": "#/$defs/fingerprint" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "description": { "$ref": "#/$defs/nonEmpty" },
        "trace": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/traceStep" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceItem" }
        }
      }
    },
    "confirmed": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["root_cause", "intended_behavior", "conditions", "execution", "remediation", "severity", "confidence"],
          "additionalProperties": false,
          "properties": {
            "root_cause": { "$ref": "#/$defs/nonEmpty" },
            "intended_behavior": { "$ref": "#/$defs/nonEmpty" },
            "conditions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["kind", "description"],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "authentication_level", "authorization_role", "user_interaction",
                      "system_configuration", "network_routing", "environmental_dependency",
                      "data_state", "timing_dependency", "third_party_dependency"
                    ]
                  },
                  "description": { "$ref": "#/$defs/nonEmpty" }
                }
              }
            },
            "execution": {
              "type": "object",
              "required": ["attacker_perspective", "payloads", "instructions", "observed_result"],
              "additionalProperties": false,
              "properties": {
                "attacker_perspective": { "$ref": "#/$defs/nonEmpty" },
                "payloads": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "instructions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmpty" } },
                "observed_result": { "$ref": "#/$defs/nonEmpty" }
              }
            },
            "remediation": {
              "type": "object",
              "required": ["strategy"],
              "additionalProperties": false,
              "properties": {
                "strategy": { "$ref": "#/$defs/nonEmpty" },
                "code_changes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["file_name", "fixed_code"],
                    "additionalProperties": false,
                    "properties": {
                      "file_name": { "$ref": "#/$defs/nonEmpty" },
                      "fixed_code": { "type": "string" }
                    }
                  }
                }
              }
            },
            "severity": {
              "type": "object",
              "required": ["likelihood", "impact", "overall_severity"],
              "additionalProperties": false,
              "properties": {
                "likelihood": { "$ref": "#/$defs/score" },
                "impact": { "$ref": "#/$defs/score" },
                "overall_severity": { "$ref": "#/$defs/severityLevel" }
              }
            },
            "confidence": {
              "type": "object",
              "required": ["score", "reason"],
              "additionalProperties": false,
              "properties": {
                "score": { "type": "string", "enum": ["low", "medium", "high"] },
                "reason": { "$ref": "#/$defs/nonEmpty" }
              }
            }
          }
        }
      ]
    },
    "needs_validation": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["claimed_root_cause", "blockers", "validation_plan"],
          "additionalProperties": false,
          "properties": {
            "claimed_root_cause": { "$ref": "#/$defs/nonEmpty" },
            "blockers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
            "validation_plan": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "local": { "$ref": "#/$defs/nonEmpty" },
                "deployment": { "$ref": "#/$defs/nonEmpty" }
              }
            }
          }
        }
      ]
    },
    "rejected": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["claimed_root_cause", "reason"],
          "additionalProperties": false,
          "properties": {
            "claimed_root_cause": { "$ref": "#/$defs/nonEmpty" },
            "reason": { "$ref": "#/$defs/nonEmpty" }
          }
        }
      ]
    }
  }
}
